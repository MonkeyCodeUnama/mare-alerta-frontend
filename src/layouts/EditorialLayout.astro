---
import { Icon } from 'astro-icon/components';
import '../shared/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  activeNav?: string;
}

const {
  title = 'Maré Alerta — Painel Operacional',
  description = 'Monitoramento de maré e chuva para comércios de Belém.',
  activeNav,
} = Astro.props;

const activePath = activeNav || Astro.url.pathname;

const navItems = [
  { href: '/dashboard', label: 'Painel', icon: 'lucide:layout-dashboard', adminOnly: false },
  { href: '/telemetria', label: 'Telemetria 24h', icon: 'lucide:activity', adminOnly: false },
  { href: '/historico', label: 'Alertas', icon: 'lucide:bell', adminOnly: false },
  { href: '/checklist', label: 'Checklist', icon: 'lucide:list-checks', adminOnly: false },
  { href: '/ocorrencias', label: 'Ocorrências', icon: 'lucide:file-plus', adminOnly: false },
  { href: '/estabelecimento', label: 'Estabelecimento', icon: 'lucide:store', adminOnly: false },
  { href: '/admin/whatsapp', label: 'WhatsApp', icon: 'lucide:message-circle', adminOnly: true },
] as const;

function isActiveRoute(href: string): boolean {
  if (activePath === href) return true;
  if (href === '/ocorrencias' && activePath.startsWith('/ocorrencias')) return true;
  return activePath.startsWith(`${href}/`);
}
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta id="sys-meta-theme-color" name="theme-color" content="#f1f4f8" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&family=Shippori+Mincho:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (function () {
        try {
          var qTheme = new URLSearchParams(window.location.search).get('theme');
          var stored = localStorage.getItem('mare-alerta-theme');
          var theme =
            qTheme === 'dark' || qTheme === 'light'
              ? qTheme
              : stored === 'dark' || stored === 'light'
                ? stored
                : 'light';
          document.documentElement.setAttribute('data-theme', theme);
          var meta = document.getElementById('sys-meta-theme-color');
          if (meta) meta.setAttribute('content', theme === 'dark' ? '#121820' : '#f1f4f8');

          var sidePref = localStorage.getItem('mare-alerta-sidebar');
          document.documentElement.setAttribute(
            'data-sidebar',
            sidePref === 'expanded' ? 'expanded' : 'collapsed'
          );
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'light');
          document.documentElement.setAttribute('data-sidebar', 'collapsed');
        }
      })();
    </script>
    <style is:inline>
      .sys-icon-moon { display: block; }
      .sys-icon-sun { display: none; }
      :root[data-theme="dark"] .sys-icon-moon { display: none; }
      :root[data-theme="dark"] .sys-icon-sun { display: block; }

      .sys-icon-expand { display: block; }
      .sys-icon-collapse { display: none; }
      :root[data-sidebar="expanded"] .sys-icon-expand { display: none; }
      :root[data-sidebar="expanded"] .sys-icon-collapse { display: block; }
    </style>
  </head>

  <body class="sys-paper-shell bg-[var(--sys-sheet-bg)] text-[var(--sys-ink)] antialiased min-h-dvh overflow-x-hidden">
    {/* Desktop Retractable Sidebar (68px collapsed <-> 224px expanded) */}
    <aside
      id="sys-sidebar"
      aria-label="Navegação principal"
      class="sys-sidebar-aside hidden lg:flex fixed inset-y-0 left-0 z-40 flex-col justify-between bg-[var(--sys-rail-bg)] py-4 px-3 select-none"
    >
      <div class="space-y-4">
        <div class="flex items-center justify-between gap-2 min-h-[36px] px-1">
          <a
            href="/"
            class="sys-sidebar-label font-brand-jp text-[12px] font-semibold tracking-[0.08em] uppercase text-[var(--sys-rail-ink)] whitespace-nowrap truncate"
          >
            MARÉ <span class="brand-alerta-flow">ALERTA</span>
          </a>

          <button
            id="sys-sidebar-toggle"
            type="button"
            aria-label="Expandir ou recolher menu lateral"
            title="Expandir ou recolher menu lateral"
            class="w-9 h-9 rounded-[8px] text-[var(--sys-rail-muted)] hover:bg-[var(--sys-rail-hover)] hover:text-[var(--sys-rail-ink)] inline-flex items-center justify-center transition-colors cursor-pointer shrink-0 mx-auto"
          >
            <Icon name="lucide:panel-left" class="sys-icon-expand w-[18px] h-[18px]" />
            <Icon name="lucide:panel-left" class="sys-icon-collapse w-[18px] h-[18px]" />
          </button>
        </div>

        <nav class="space-y-1">
          {navItems.map((item) => {
            const active = isActiveRoute(item.href);
            return (
              <div
                data-admin-only={item.adminOnly ? 'true' : undefined}
                data-display-class={item.adminOnly ? 'flex' : undefined}
                class={`sys-rail-item relative items-center ${item.adminOnly ? 'hidden' : 'flex'}`}
              >
                <a
                  href={item.href}
                  aria-label={item.label}
                  aria-current={active ? 'page' : undefined}
                  class={`w-full h-10 px-2.5 rounded-[9px] flex items-center gap-3 transition-colors ${
                    active
                      ? 'bg-[var(--sys-rail-active-bg)] text-[var(--sys-rail-active-ink)] font-medium'
                      : 'text-[var(--sys-rail-muted)] hover:bg-[var(--sys-rail-hover)] hover:text-[var(--sys-rail-ink)]'
                  }`}
                >
                  <Icon name={item.icon} class="w-[17px] h-[17px] shrink-0 mx-auto lg:mx-0" />
                  <span class="sys-sidebar-label text-[13px] whitespace-nowrap truncate">
                    {item.label}
                  </span>
                </a>
                <span class="sys-rail-tooltip" role="tooltip">
                  {item.label}
                </span>
              </div>
            );
          })}
        </nav>
      </div>

      <div class="space-y-1.5 pt-3 border-t border-[var(--sys-rail-border)]">
        <div class="sys-rail-item relative flex items-center">
          <button
            id="sys-theme-toggle"
            type="button"
            aria-label="Alternar modo claro e escuro"
            class="w-full h-9 px-2.5 rounded-[8px] text-[var(--sys-rail-muted)] hover:bg-[var(--sys-rail-hover)] hover:text-[var(--sys-rail-ink)] inline-flex items-center gap-3 transition-colors cursor-pointer"
          >
            <Icon name="lucide:moon" class="sys-icon-moon w-[17px] h-[17px] shrink-0" />
            <Icon name="lucide:sun" class="sys-icon-sun w-[17px] h-[17px] shrink-0" />
            <span class="sys-sidebar-label text-xs whitespace-nowrap">Alternar tema</span>
          </button>
          <span class="sys-rail-tooltip" role="tooltip">
            Alternar tema
          </span>
        </div>

        <div id="auth-slot" class="sys-rail-item relative flex items-center">
          <a
            id="auth-login-desktop"
            href="/entrar"
            aria-label="Entrar"
            class="w-full h-9 px-2.5 rounded-[8px] text-[var(--sys-rail-muted)] hover:bg-[var(--sys-rail-hover)] hover:text-[var(--sys-rail-ink)] inline-flex items-center gap-3 transition-colors"
          >
            <Icon name="lucide:log-in" class="w-[17px] h-[17px] shrink-0" />
            <span class="sys-sidebar-label text-xs whitespace-nowrap">Entrar</span>
          </a>
          <button
            id="auth-logout-desktop"
            type="button"
            aria-label="Sair da conta"
            class="hidden w-full h-9 px-2.5 rounded-[8px] text-[var(--sys-rail-muted)] hover:bg-[var(--sys-rail-hover)] hover:text-[var(--sys-rail-ink)] items-center gap-3 transition-colors cursor-pointer"
          >
            <Icon name="lucide:log-out" class="w-[17px] h-[17px] shrink-0" />
            <span id="auth-logout-label-desktop" class="sys-sidebar-label text-xs whitespace-nowrap truncate">
              Sair
            </span>
          </button>
          <span id="auth-tooltip-desktop" class="sys-rail-tooltip" role="tooltip">
            Entrar
          </span>
        </div>
      </div>
    </aside>

    {/* Mobile Header — Menu à esquerda no estilo minimalista da Landing Page */}
    <header class="lg:hidden sticky top-0 z-30 h-[52px] bg-[var(--sys-rail-bg)] text-[var(--sys-rail-ink)] px-4 flex items-center justify-between">
      <div class="flex items-center gap-2.5 min-w-0">
        <button
          id="mobile-menu-open"
          type="button"
          aria-label="Abrir navegação"
          aria-controls="app-mobile-drawer"
          aria-expanded="false"
          class="inline-flex items-center justify-center w-8 h-8 -ml-1.5 text-[var(--sys-rail-ink)] hover:opacity-75 transition-opacity cursor-pointer shrink-0"
        >
          <svg
            class="w-4 h-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M4 9h16" />
            <path d="M7 15h13" />
          </svg>
        </button>

        <a
          href="/"
          class="font-brand-jp text-[13px] font-semibold tracking-[0.08em] uppercase text-[var(--sys-rail-ink)] whitespace-nowrap"
        >
          MARÉ <span class="brand-alerta-flow">ALERTA</span>
        </a>
      </div>

      <div class="flex items-center gap-2 shrink-0">
        <button
          id="sys-theme-toggle-mobile"
          type="button"
          aria-label="Alternar modo claro e escuro"
          class="w-8 h-8 rounded-[8px] text-[var(--sys-rail-muted)] hover:text-[var(--sys-rail-ink)] hover:bg-[var(--sys-rail-hover)] inline-flex items-center justify-center transition-colors cursor-pointer"
        >
          <Icon name="lucide:moon" class="sys-icon-moon w-4 h-4" />
          <Icon name="lucide:sun" class="sys-icon-sun w-4 h-4" />
        </button>
      </div>
    </header>

    {/* Mobile Left Drawer */}
    <div id="app-mobile-drawer" class="lg:hidden hidden fixed inset-0 z-50" role="dialog" aria-modal="true">
      <div
        id="mobile-drawer-backdrop"
        class="fixed inset-0 bg-black/45 opacity-0 transition-opacity duration-200"
      />
      <nav
        id="mobile-drawer-panel"
        aria-label="Menu mobile"
        class="relative z-10 w-[264px] max-w-[82vw] h-full bg-[var(--sys-rail-bg)] text-[var(--sys-rail-ink)] flex flex-col justify-between p-4 -translate-x-full transition-transform duration-200"
      >
        <div class="space-y-4">
          <div class="flex items-center justify-between pb-3 border-b border-[var(--sys-rail-border)]">
            <a
              href="/"
              class="font-brand-jp text-xs font-semibold tracking-[0.08em] uppercase text-[var(--sys-rail-ink)]"
            >
              MARÉ <span class="brand-alerta-flow">ALERTA</span>
            </a>
            <button
              id="mobile-menu-close"
              type="button"
              aria-label="Fechar navegação"
              class="w-8 h-8 rounded-[8px] text-[var(--sys-rail-muted)] hover:text-[var(--sys-rail-ink)] hover:bg-[var(--sys-rail-hover)] inline-flex items-center justify-center transition-colors cursor-pointer"
            >
              <Icon name="lucide:x" class="w-4 h-4" />
            </button>
          </div>

          <ul class="space-y-1">
            {navItems.map((item) => {
              const active = isActiveRoute(item.href);
              return (
                <li
                  data-admin-only={item.adminOnly ? 'true' : undefined}
                  class={item.adminOnly ? 'hidden' : undefined}
                >
                  <a
                    href={item.href}
                    aria-current={active ? 'page' : undefined}
                    class={`flex items-center gap-3 px-3 py-2.5 rounded-[9px] text-[13px] transition-colors ${
                      active
                        ? 'bg-[var(--sys-rail-active-bg)] text-[var(--sys-rail-active-ink)] font-medium'
                        : 'text-[var(--sys-rail-muted)] hover:bg-[var(--sys-rail-hover)] hover:text-[var(--sys-rail-ink)]'
                    }`}
                  >
                    <Icon name={item.icon} class="w-4 h-4 shrink-0" />
                    <span>{item.label}</span>
                  </a>
                </li>
              );
            })}
          </ul>
        </div>

        <div class="space-y-3 pt-4 border-t border-[var(--sys-rail-border)]">
          <div class="px-1">
            <strong id="auth-role-label" class="block text-xs font-medium text-[var(--sys-ink)] truncate">
              Conta
            </strong>
          </div>

          <div id="auth-slot-mobile" class="grid grid-cols-2 gap-2">
            <a
              id="auth-login-mobile"
              href="/entrar"
              class="inline-flex items-center justify-center rounded-[8px] border border-[var(--sys-border-strong)] px-3 py-2 text-xs font-medium text-[var(--sys-ink)] hover:bg-[var(--sys-rail-hover)]"
            >
              Entrar
            </a>
            <a
              id="auth-register-mobile"
              href="/cadastro"
              class="inline-flex items-center justify-center rounded-[8px] bg-[var(--sys-brand)] px-3 py-2 text-xs font-medium text-[var(--sys-brand-ink)]"
            >
              Criar conta
            </a>
            <button
              id="auth-logout-mobile"
              type="button"
              class="hidden col-span-2 items-center justify-center gap-2 rounded-[8px] border border-[var(--sys-border-strong)] bg-[var(--sys-card-bg)] px-3 py-2 text-xs font-medium text-[var(--sys-ink)] hover:bg-[var(--sys-rail-hover)] cursor-pointer"
            >
              <Icon name="lucide:log-out" class="w-4 h-4" />
              <span>Sair</span>
            </button>
          </div>
        </div>
      </nav>
    </div>

    {/* Main Workspace Area */}
    <div class="sys-main-wrap min-h-dvh flex flex-col">
      <div class="sys-paper-sheet flex-1 bg-[var(--sys-sheet-bg)] text-[var(--sys-ink)] flex flex-col min-w-0">
        <main class="flex-1 w-full max-w-[1140px] mx-auto px-4 py-5 sm:px-8 sm:py-8 lg:px-10 lg:py-9 min-w-0">
          <slot />
        </main>

        <footer class="w-full max-w-[1140px] mx-auto px-4 sm:px-8 lg:px-10 py-5 border-t border-[var(--sys-border)] flex flex-wrap items-center justify-between gap-3 text-xs text-[var(--sys-ink-3)]">
          <span>Maré Alerta · Belém/PA</span>
          <a href="/" class="hover:text-[var(--sys-link,var(--sys-brand))] transition-colors">
            Início
          </a>
        </footer>
      </div>
    </div>

    <script is:inline>
      (function () {
        var drawer = document.getElementById('app-mobile-drawer');
        var backdrop = document.getElementById('mobile-drawer-backdrop');
        var panel = document.getElementById('mobile-drawer-panel');
        var openBtn = document.getElementById('mobile-menu-open');
        var closeBtn = document.getElementById('mobile-menu-close');
        var sideToggle = document.getElementById('sys-sidebar-toggle');

        function setDrawer(open) {
          if (!drawer || !backdrop || !panel || !openBtn) return;
          openBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
          if (open) {
            drawer.classList.remove('hidden');
            document.body.style.overflow = 'hidden';
            requestAnimationFrame(function () {
              backdrop.classList.remove('opacity-0');
              panel.classList.remove('-translate-x-full');
            });
          } else {
            backdrop.classList.add('opacity-0');
            panel.classList.add('-translate-x-full');
            document.body.style.overflow = '';
            setTimeout(function () {
              drawer.classList.add('hidden');
            }, 200);
          }
        }

        function syncSidebarUi() {
          if (!sideToggle) return;
          var expanded = document.documentElement.getAttribute('data-sidebar') === 'expanded';
          sideToggle.classList.toggle('mx-auto', !expanded);
          sideToggle.classList.toggle('ml-auto', expanded);
        }

        if (sideToggle) {
          syncSidebarUi();
          sideToggle.addEventListener('click', function () {
            var current = document.documentElement.getAttribute('data-sidebar');
            var next = current === 'expanded' ? 'collapsed' : 'expanded';
            document.documentElement.setAttribute('data-sidebar', next);
            try {
              localStorage.setItem('mare-alerta-sidebar', next);
            } catch (e) {}
            syncSidebarUi();
          });
        }

        function toggleSystemTheme() {
          var current = document.documentElement.getAttribute('data-theme') || 'light';
          var next = current === 'dark' ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', next);
          try {
            localStorage.setItem('mare-alerta-theme', next);
            if (window.location.search.indexOf('theme=') !== -1) {
              var nextUrl = new URL(window.location.href);
              nextUrl.searchParams.delete('theme');
              window.history.replaceState({}, '', nextUrl.toString());
            }
          } catch (e) {}
          var meta = document.getElementById('sys-meta-theme-color');
          if (meta) meta.setAttribute('content', next === 'dark' ? '#121820' : '#f1f4f8');
          window.dispatchEvent(new CustomEvent('theme-changed', { detail: next }));
        }

        var themeBtnDesk = document.getElementById('sys-theme-toggle');
        var themeBtnMob = document.getElementById('sys-theme-toggle-mobile');
        if (themeBtnDesk) themeBtnDesk.addEventListener('click', toggleSystemTheme);
        if (themeBtnMob) themeBtnMob.addEventListener('click', toggleSystemTheme);

        if (openBtn) openBtn.addEventListener('click', function () { setDrawer(true); });
        if (closeBtn) closeBtn.addEventListener('click', function () { setDrawer(false); });
        if (backdrop) backdrop.addEventListener('click', function () { setDrawer(false); });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && drawer && !drawer.classList.contains('hidden')) {
            setDrawer(false);
          }
        });

          function doLogout() {
          try {
            localStorage.removeItem('mare_alerta_token');
            localStorage.removeItem('mare_alerta_refresh_token');
            localStorage.removeItem('mare_alerta_user');
          } catch (e) {}
          window.dispatchEvent(new CustomEvent('auth-session-changed', { detail: null }));
          window.location.href = '/entrar';
        }

        var deskLogout = document.getElementById('auth-logout-desktop');
        var mobLogout = document.getElementById('auth-logout-mobile');
        if (deskLogout) deskLogout.addEventListener('click', doLogout);
        if (mobLogout) mobLogout.addEventListener('click', doLogout);

        function renderAuthState() {
          var deskLogin = document.getElementById('auth-login-desktop');
          var deskTooltip = document.getElementById('auth-tooltip-desktop');
          var deskLogoutLabel = document.getElementById('auth-logout-label-desktop');
          var mobLogin = document.getElementById('auth-login-mobile');
          var mobRegister = document.getElementById('auth-register-mobile');
          var roleLabel = document.getElementById('auth-role-label');

          var rawUser = null;
          var token = null;
          try {
            rawUser = localStorage.getItem('mare_alerta_user');
            token = localStorage.getItem('mare_alerta_token');
          } catch (e) {}

          var path = window.location.pathname.replace(/\/+$/, '') || '/';
          var publicSystemRoutes = ['/telemetria'];
          if (!token && publicSystemRoutes.indexOf(path) === -1) {
            window.location.replace('/entrar');
            return;
          }

          function toggleEl(el, visible, displayClass) {
            if (!el) return;
            el.classList.toggle('hidden', !visible);
            if (displayClass) el.classList.toggle(displayClass, visible);
          }

          var user = null;
          if (rawUser) {
            try {
              user = JSON.parse(rawUser);
            } catch (e) {}
          }

          if (roleLabel) {
            roleLabel.textContent = user
              ? user.email || (user.role === 'ADMIN' ? 'Administrador' : 'Lojista')
              : 'Visitante';
          }

          var signedIn = Boolean(token && user);
          toggleEl(deskLogin, !signedIn, 'inline-flex');
          toggleEl(deskLogout, signedIn, 'inline-flex');
          if (deskTooltip) {
            deskTooltip.textContent = signedIn
              ? 'Sair (' + (user.email || user.role || 'Conta') + ')'
              : 'Entrar';
          }
          if (deskLogoutLabel && signedIn) {
            deskLogoutLabel.textContent = 'Sair';
          }

          toggleEl(mobLogin, !signedIn, 'inline-flex');
          toggleEl(mobRegister, !signedIn, 'inline-flex');
          toggleEl(mobLogout, signedIn, 'inline-flex');

          var roleUpper = user && user.role ? String(user.role).trim().toUpperCase() : '';
          var isAdmin =
            roleUpper === 'ADMIN' || roleUpper === 'SUPERADMIN' || roleUpper === 'ROLE_ADMIN';
          document.querySelectorAll('[data-admin-only]').forEach(function (el) {
            toggleEl(el, isAdmin, el.getAttribute('data-display-class') || '');
          });
        }

        renderAuthState();
        window.addEventListener('auth-session-changed', renderAuthState);

        if ('serviceWorker' in navigator) {
          var isLocalhost =
            window.location.hostname === 'localhost' ||
            window.location.hostname === '127.0.0.1';
          if (isLocalhost) {
            navigator.serviceWorker
              .getRegistrations()
              .then(function (regs) {
                regs.forEach(function (reg) {
                  reg.unregister();
                });
              })
              .catch(function () {});
          } else {
            window.addEventListener('load', function () {
              navigator.serviceWorker.register('/sw.js').catch(function () {});
            });
          }
        }
      })();
    </script>
  </body>
</html>
