---
import '../../shared/styles/global.css';
import { landingCopy, type LandingLocale } from '../../shared/i18n/landing';

interface Props {
  locale?: LandingLocale;
}

const { locale = 'pt-br' } = Astro.props;
const t = landingCopy[locale];

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Maré Alerta',
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'Web',
  inLanguage: t.htmlLang,
  description: t.meta.schemaDescription,
});
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <meta name="theme-color" id="meta-theme-color" content="#f4f6f9" />
    <link rel="alternate" hreflang="pt-BR" href="/" />
    <link rel="alternate" hreflang="en" href="/en/" />
    <link rel="alternate" hreflang="x-default" href="/" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={t.ogLocale} />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:image" content="/images/guajara-orla.webp" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      as="image"
      href="/images/guajara-orla-mobile.avif"
      type="image/avif"
      media="(max-width: 767px)"
      fetchpriority="high"
    />
    <link
      rel="preload"
      as="image"
      href="/images/guajara-orla.avif"
      type="image/avif"
      media="(min-width: 768px)"
      fetchpriority="high"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&family=Shippori+Mincho:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={jsonLd} />
    <script is:inline>
      (function () {
        try {
          var params = new URLSearchParams(window.location.search);
          var qTheme = params.get('theme');
          var stored = localStorage.getItem('mare-alerta-theme');
          var theme =
            qTheme === 'dark' || qTheme === 'light'
              ? qTheme
              : stored === 'dark' || stored === 'light'
                ? stored
                : 'light';
          if (qTheme === 'dark' || qTheme === 'light') {
            localStorage.setItem('mare-alerta-theme', theme);
          }
          document.documentElement.setAttribute('data-theme', theme);
          var metaTheme = document.getElementById('meta-theme-color');
          if (metaTheme) metaTheme.setAttribute('content', theme === 'dark' ? '#0d131f' : '#f4f6f9');
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
    <style>
      /* Barra superior ponta a ponta estilo Delphi/211805 + links 211958 */
      #lp-navbar {
        --nav-text: oklch(97% 0.004 230);
        --nav-link: oklch(90% 0.008 232 / 0.78);
        --nav-link-hover: oklch(99% 0 0);
        color: var(--nav-text);
        transition: color 240ms ease;
      }

      #lp-navbar.lp-navbar-on-light {
        --nav-text: oklch(16% 0.020 242);
        --nav-link: oklch(32% 0.020 240 / 0.85);
        --nav-link-hover: oklch(14% 0.024 244);
      }

      .lp-top-bar-backdrop {
        position: absolute;
        inset: 0 0 -18px 0;
        pointer-events: none;
        background: linear-gradient(
          to bottom,
          oklch(8% 0.022 246 / 0.78) 0%,
          oklch(8% 0.022 246 / 0.42) 58%,
          transparent 100%
        );
        backdrop-filter: blur(16px) saturate(145%);
        -webkit-backdrop-filter: blur(16px) saturate(145%);
        mask-image: linear-gradient(to bottom, black 0%, black 62%, transparent 100%);
        -webkit-mask-image: linear-gradient(to bottom, black 0%, black 62%, transparent 100%);
        transition: background 260ms ease, opacity 260ms ease;
      }

      #lp-navbar.lp-navbar-on-light .lp-top-bar-backdrop {
        background: linear-gradient(
          to bottom,
          oklch(97% 0.005 235 / 0.88) 0%,
          oklch(97% 0.005 235 / 0.56) 60%,
          transparent 100%
        );
      }

      .lp-nav-brand {
        color: var(--nav-text);
        transition: color 240ms ease;
      }

      .lp-nav-link {
        color: var(--nav-link);
        transition: color 200ms ease, opacity 150ms ease;
      }
      .lp-nav-link:hover {
        color: var(--nav-link-hover);
      }

      [data-i18n] {
        transition: opacity 150ms ease;
      }
      html.is-switching-lang [data-i18n] {
        opacity: 0.25;
      }
      [data-landing-hidden] {
        display: none !important;
      }

      /* Menu mobile fullscreen editorial adaptado à paleta oceânica Maré Alerta */
      #lp-mobile-menu {
        background:
          radial-gradient(92% 60% at 80% 14%, oklch(32% 0.115 243 / 0.78), transparent 68%),
          radial-gradient(76% 52% at 14% 88%, oklch(26% 0.095 246 / 0.55), transparent 65%),
          linear-gradient(180deg, oklch(17.5% 0.068 246 / 0.985) 0%, oklch(11.5% 0.044 246 / 0.992) 100%);
        backdrop-filter: blur(22px);
        -webkit-backdrop-filter: blur(22px);
        transition: opacity 240ms ease, transform 280ms cubic-bezier(0.22, 1, 0.36, 1), visibility 240ms ease;
      }
      :root[data-theme="dark"] #lp-mobile-menu {
        background:
          radial-gradient(90% 58% at 80% 14%, oklch(25% 0.088 244 / 0.70), transparent 68%),
          radial-gradient(76% 52% at 14% 88%, oklch(20% 0.068 246 / 0.45), transparent 65%),
          linear-gradient(180deg, oklch(14% 0.045 246 / 0.99) 0%, oklch(9% 0.024 246 / 0.995) 100%);
      }
      #lp-mobile-menu.is-closed {
        opacity: 0;
        transform: translateY(-10px);
        pointer-events: none;
        visibility: hidden;
      }
      #lp-mobile-menu.is-open {
        opacity: 1;
        transform: translateY(0);
        pointer-events: auto;
        visibility: visible;
      }

      .lp-mobile-item {
        color: oklch(88% 0.025 232 / 0.50);
        border-bottom: 1px solid oklch(78% 0.055 234 / 0.16);
        transition: color 200ms ease, border-color 200ms ease;
      }
      .lp-mobile-item:hover {
        color: oklch(97% 0.012 230 / 0.90);
        border-bottom-color: oklch(78% 0.080 232 / 0.40);
      }
      .lp-mobile-item.is-active {
        color: oklch(99% 0.004 230);
        border-bottom-color: oklch(78% 0.105 232 / 0.85);
      }

      /* Véu no Hero adaptável para troca de tema clara e visível */
      .hero-top-scrim {
        opacity: 0.40;
        background: linear-gradient(
          to bottom,
          oklch(12% 0.020 244 / 0.42) 0%,
          oklch(12% 0.016 244 / 0.14) 55%,
          transparent 100%
        );
      }
      :root[data-theme="dark"] .hero-top-scrim {
        opacity: 1;
      }

      .hero-theme-veil {
        background: linear-gradient(
          to top,
          oklch(10% 0.025 246 / 0.80) 0%,
          oklch(18% 0.036 244 / 0.30) 48%,
          transparent 100%
        );
        transition: background 300ms ease, opacity 300ms ease;
      }
      :root[data-theme="dark"] .hero-theme-veil {
        background: linear-gradient(
          to top,
          oklch(6% 0.018 246 / 0.94) 0%,
          oklch(10% 0.024 246 / 0.56) 52%,
          oklch(8% 0.018 246 / 0.25) 100%
        );
      }

      /* Fonte japonesa Mincho para a marca MARÉ ALERTA */
      .font-brand-jp {
        font-family: 'Shippori Mincho', Georgia, serif;
        letter-spacing: 0.04em;
      }

      /* Azul escuro oceânico animado apenas para a palavra ALERTA */
      @keyframes alertaFlow {
        0% {
          background-position: 0% 50%;
        }
        50% {
          background-position: 100% 50%;
        }
        100% {
          background-position: 0% 50%;
        }
      }

      .brand-alerta-flow {
        background: linear-gradient(
          115deg,
          oklch(22% 0.085 246) 0%,
          oklch(38% 0.115 240) 34%,
          oklch(52% 0.095 232) 50%,
          oklch(38% 0.115 240) 66%,
          oklch(22% 0.085 246) 100%
        );
        background-size: 220% 220%;
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        animation: alertaFlow 5.5s ease-in-out infinite;
      }

      :root[data-theme="dark"] .brand-alerta-flow,
      #lp-navbar:not(.lp-navbar-on-light) .brand-alerta-flow,
      #lp-mobile-menu .brand-alerta-flow {
        background: linear-gradient(
          115deg,
          oklch(62% 0.095 238) 0%,
          oklch(76% 0.085 230) 34%,
          oklch(88% 0.035 225) 50%,
          oklch(76% 0.085 230) 66%,
          oklch(62% 0.095 238) 100%
        );
        background-size: 220% 220%;
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }

      /* Botão compacto animado de alternância de tema (Sol <-> Lua) sem card */
      #landing-theme-btn svg {
        transition: transform 320ms cubic-bezier(0.22, 1, 0.36, 1), opacity 220ms ease, color 220ms ease;
      }
      #theme-icon-sun {
        color: oklch(86% 0.14 82);
      }
      #lp-navbar.lp-navbar-on-light #theme-icon-sun {
        color: oklch(58% 0.17 68);
      }
      #theme-icon-moon {
        color: oklch(82% 0.095 230);
      }
      :root:not([data-theme="dark"]) #theme-icon-sun {
        opacity: 1;
        transform: rotate(0deg) scale(1);
      }
      :root:not([data-theme="dark"]) #theme-icon-moon {
        opacity: 0;
        transform: rotate(-45deg) scale(0.65);
      }
      :root[data-theme="dark"] #theme-icon-sun {
        opacity: 0;
        transform: rotate(45deg) scale(0.65);
      }
      :root[data-theme="dark"] #theme-icon-moon {
        opacity: 1;
        transform: rotate(0deg) scale(1);
      }

      /* Botão com reflexo líquido direcionado pelo ponteiro */
      .btn-water-pill {
        position: relative;
        overflow: hidden;
        --mx: 50%;
        --my: 50%;
        transition: transform 220ms ease, box-shadow 260ms ease, background-color 220ms ease;
      }
      .btn-water-pill::before {
        content: "";
        position: absolute;
        inset: -2px;
        background: radial-gradient(
          130px circle at var(--mx) var(--my),
          oklch(82% 0.11 210 / 0.42),
          oklch(52% 0.16 234 / 0.18) 45%,
          transparent 72%
        );
        opacity: 0;
        transition: opacity 260ms ease;
        pointer-events: none;
      }
      .btn-water-pill:hover::before {
        opacity: 1;
      }
      .btn-water-pill:hover {
        transform: translateY(-1px);
      }

      /* Revelação progressiva dos blocos */
      .reveal-item {
        opacity: 0;
        transform: translateY(20px);
        transition: opacity 700ms cubic-bezier(0.22, 1, 0.36, 1), transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
      }
      .reveal-item.is-visible {
        opacity: 1;
        transform: translateY(0);
      }
      @media (prefers-reduced-motion: reduce) {
        .reveal-item {
          opacity: 1;
          transform: none;
          transition: none;
        }
      }

      /* Palco azul marinho + preto coeso entre Light e Dark mode */
      .routine-card-1 {
        background: radial-gradient(120% 90% at 15% 8%, oklch(24% 0.068 246), transparent 62%),
          linear-gradient(160deg, oklch(15% 0.042 246) 0%, oklch(8.5% 0.016 246) 100%);
      }
      .routine-card-2 {
        background: radial-gradient(120% 90% at 50% 8%, oklch(26% 0.072 240), transparent 62%),
          linear-gradient(160deg, oklch(14.5% 0.044 242) 0%, oklch(8.5% 0.015 246) 100%);
      }
      .routine-card-3 {
        background: radial-gradient(120% 90% at 85% 8%, oklch(24% 0.064 248), transparent 62%),
          linear-gradient(160deg, oklch(15% 0.040 246) 0%, oklch(8.5% 0.016 246) 100%);
      }

      .step-stage {
        background:
          radial-gradient(105% 80% at 18% 14%, oklch(24% 0.065 245 / 0.85), transparent 60%),
          radial-gradient(90% 75% at 86% 86%, oklch(20% 0.045 238 / 0.60), transparent 58%),
          linear-gradient(160deg, oklch(13% 0.032 246) 0%, oklch(8% 0.015 246) 100%);
      }

      /* Carcaça de Smartphone vertical fiel à referência dark titanium */
      .phone-bezel {
        position: relative;
        background: linear-gradient(160deg, oklch(21% 0.020 244) 0%, oklch(9% 0.012 246) 55%, oklch(16% 0.016 244) 100%);
        border: 1.5px solid oklch(38% 0.024 240 / 0.72);
        box-shadow:
          0 28px 65px rgba(2, 6, 16, 0.56),
          inset 0 1px 0 oklch(85% 0.015 235 / 0.24);
      }
      .phone-bezel::before {
        content: "";
        position: absolute;
        left: -3.5px;
        top: 96px;
        width: 2.5px;
        height: 32px;
        border-radius: 3px 0 0 3px;
        background: oklch(34% 0.020 240 / 0.85);
        box-shadow: 0 44px 0 oklch(34% 0.020 240 / 0.85);
      }
      .phone-bezel::after {
        content: "";
        position: absolute;
        right: -3.5px;
        top: 112px;
        width: 2.5px;
        height: 48px;
        border-radius: 0 3px 3px 0;
        background: oklch(34% 0.020 240 / 0.85);
      }
      .phone-screen {
        background: oklch(96.8% 0.003 242);
        border: 1px solid oklch(28% 0.020 242 / 0.65);
      }
      :root[data-theme="dark"] .phone-screen {
        background: oklch(16.0% 0.011 244);
      }
      .phone-notch-bar {
        background: oklch(98.6% 0.002 242);
      }
      :root[data-theme="dark"] .phone-notch-bar {
        background: oklch(18.6% 0.012 244);
      }

      .lp-preview-dark {
        display: none;
      }
      :root[data-theme="dark"] .lp-preview-light {
        display: none;
      }
      :root[data-theme="dark"] .lp-preview-dark {
        display: block;
      }

      /* Banda azul oceânico profundo (Light e Dark mode) */
      .lp-ocean-band {
        overflow: hidden;
        background:
          radial-gradient(76% 62% at 50% 46%, oklch(28% 0.088 242 / 0.68) 0%, transparent 74%),
          linear-gradient(180deg, oklch(18.5% 0.062 245) 0%, oklch(12.5% 0.042 246) 100%);
        color: oklch(97.5% 0.004 230);
      }
      :root[data-theme="dark"] .lp-ocean-band {
        background:
          radial-gradient(78% 64% at 50% 45%, oklch(21% 0.068 245 / 0.56) 0%, transparent 72%),
          linear-gradient(180deg, oklch(13% 0.036 246) 0%, oklch(8.5% 0.018 246) 100%);
      }
      .lp-ocean-band .step-stage {
        background:
          radial-gradient(105% 80% at 18% 14%, oklch(28% 0.078 244 / 0.65), transparent 60%),
          linear-gradient(160deg, oklch(13.5% 0.040 246 / 0.90) 0%, oklch(8.5% 0.020 246 / 0.94) 100%);
        border-color: rgba(255, 255, 255, 0.14);
        box-shadow: 0 24px 60px rgba(2, 8, 24, 0.42);
      }

      /* Névoa costeira contínua e suave entre seções claras e faixas em azul oceânico */
      .lp-mist-top,
      .lp-mist-bottom,
      .lp-mist-footer {
        position: absolute;
        left: 0;
        right: 0;
        height: clamp(72px, 8.5vw, 128px);
        pointer-events: none;
        z-index: 15;
      }
      .lp-mist-top {
        top: -2px;
        background: linear-gradient(
          to bottom,
          var(--color-canvas) 0%,
          color-mix(in oklch, var(--color-canvas) 92%, transparent) 14%,
          color-mix(in oklch, var(--color-canvas) 72%, transparent) 30%,
          color-mix(in oklch, var(--color-canvas) 44%, transparent) 50%,
          color-mix(in oklch, var(--color-canvas) 20%, transparent) 72%,
          color-mix(in oklch, var(--color-canvas) 6%, transparent) 88%,
          transparent 100%
        );
      }
      .lp-mist-bottom {
        bottom: -2px;
        background: linear-gradient(
          to top,
          var(--color-canvas) 0%,
          color-mix(in oklch, var(--color-canvas) 92%, transparent) 14%,
          color-mix(in oklch, var(--color-canvas) 72%, transparent) 30%,
          color-mix(in oklch, var(--color-canvas) 44%, transparent) 50%,
          color-mix(in oklch, var(--color-canvas) 20%, transparent) 72%,
          color-mix(in oklch, var(--color-canvas) 6%, transparent) 88%,
          transparent 100%
        );
      }
      .lp-mist-top.lp-mist-lg,
      .lp-mist-bottom.lp-mist-lg {
        height: clamp(96px, 11.5vw, 168px);
      }
      .lp-mist-footer {
        bottom: -2px;
        height: clamp(28px, 3.5vw, 48px);
        background: linear-gradient(
          to top,
          var(--color-surface) 0%,
          color-mix(in oklch, var(--color-surface) 76%, transparent) 28%,
          color-mix(in oklch, var(--color-surface) 38%, transparent) 64%,
          transparent 100%
        );
      }

      .final-cta-stage {
        overflow: hidden;
        background:
          radial-gradient(68% 60% at 50% 48%, oklch(28% 0.088 242 / 0.66) 0%, transparent 74%),
          linear-gradient(180deg, oklch(18% 0.060 245) 0%, oklch(12% 0.040 246) 100%);
      }
      .final-cta-stage .lp-mist-top {
        height: clamp(48px, 5.5vw, 84px);
        background: linear-gradient(
          to bottom,
          var(--color-canvas) 0%,
          color-mix(in oklch, var(--color-canvas) 80%, transparent) 24%,
          color-mix(in oklch, var(--color-canvas) 40%, transparent) 58%,
          transparent 100%
        );
      }
      :root[data-theme="dark"] .final-cta-stage {
        background:
          radial-gradient(66% 58% at 50% 48%, oklch(21% 0.068 245 / 0.54) 0%, transparent 72%),
          linear-gradient(180deg, oklch(12.5% 0.034 246) 0%, oklch(8% 0.016 246) 100%);
      }

      /* Animações das etapas do sistema */
      @keyframes chipHighlight1 {
        0%, 100% { border-color: oklch(58% 0.14 236 / 0.8); background-color: oklch(24% 0.038 236 / 0.72); }
        45%, 80% { border-color: oklch(34% 0.016 232 / 0.35); background-color: oklch(19% 0.014 234 / 0.6); }
      }
      @keyframes chipHighlight2 {
        0%, 28% { border-color: oklch(34% 0.016 232 / 0.35); background-color: oklch(19% 0.014 234 / 0.6); }
        34%, 64% { border-color: oklch(58% 0.14 236 / 0.8); background-color: oklch(24% 0.038 236 / 0.72); }
        70%, 100% { border-color: oklch(34% 0.016 232 / 0.35); background-color: oklch(19% 0.014 234 / 0.6); }
      }
      @keyframes chipHighlight3 {
        0%, 60% { border-color: oklch(34% 0.016 232 / 0.35); background-color: oklch(19% 0.014 234 / 0.6); }
        68%, 94% { border-color: oklch(58% 0.14 236 / 0.8); background-color: oklch(24% 0.038 236 / 0.72); }
        100% { border-color: oklch(34% 0.016 232 / 0.35); background-color: oklch(19% 0.014 234 / 0.6); }
      }
      .anim-chip-1 { animation: chipHighlight1 6s ease-in-out infinite; }
      .anim-chip-2 { animation: chipHighlight2 6s ease-in-out infinite; }
      .anim-chip-3 { animation: chipHighlight3 6s ease-in-out infinite; }

      @keyframes tideWaveDrift {
        0% { transform: translateX(0); }
        100% { transform: translateX(-50%); }
      }
      .anim-wave-track {
        animation: tideWaveDrift 7s linear infinite;
      }

      @keyframes checkRowActive1 {
        0%, 15% { opacity: 0.55; }
        22%, 90% { opacity: 1; }
        100% { opacity: 0.55; }
      }
      @keyframes checkRowActive2 {
        0%, 42% { opacity: 0.55; }
        50%, 90% { opacity: 1; }
        100% { opacity: 0.55; }
      }
      @keyframes checkRowActive3 {
        0%, 68% { opacity: 0.55; }
        75%, 94% { opacity: 1; }
        100% { opacity: 0.55; }
      }
      .anim-check-1 { animation: checkRowActive1 6.4s ease-in-out infinite; }
      .anim-check-2 { animation: checkRowActive2 6.4s ease-in-out infinite; }
      .anim-check-3 { animation: checkRowActive3 6.4s ease-in-out infinite; }

      @keyframes scanSweep {
        0% { transform: translateY(-100%); opacity: 0; }
        18% { opacity: 0.85; }
        65% { transform: translateY(360%); opacity: 0.85; }
        75%, 100% { transform: translateY(360%); opacity: 0; }
      }
      .anim-photo-scan {
        animation: scanSweep 5.8s ease-in-out infinite;
      }

      @keyframes protocolBadgePop {
        0%, 35% { opacity: 0.45; transform: translateY(4px); }
        48%, 90% { opacity: 1; transform: translateY(0); }
        100% { opacity: 0.45; transform: translateY(4px); }
      }
      .anim-protocol-badge {
        animation: protocolBadgePop 5.8s ease-in-out infinite;
      }
    </style>
  </head>

  <body class="bg-[var(--color-canvas)] text-[var(--color-text-primary)] antialiased transition-colors duration-300">
    <!-- Navbar ponta a ponta com blur gradual e controles ancorados à direita -->
    <header
      id="lp-navbar"
      class="fixed top-0 inset-x-0 z-50"
    >
      <div class="lp-top-bar-backdrop" aria-hidden="true"></div>

      <div class="max-w-7xl mx-auto px-5 sm:px-10 h-16 sm:h-[72px] relative z-10 flex items-center justify-between lg:grid lg:grid-cols-[1fr_auto_1fr] gap-3">
        <a
          href="#hero-sticky"
          class="lp-nav-brand lg:justify-self-start font-brand-jp text-xs sm:text-[13px] font-semibold tracking-[0.06em] leading-none whitespace-nowrap shrink-0"
        >
          MARÉ <span class="brand-alerta-flow">ALERTA</span>
        </a>

        <nav
          aria-label={t.nav.ariaLabel}
          data-i18n-aria="nav.ariaLabel"
          class="hidden lg:flex lg:justify-self-center items-center gap-6 xl:gap-10 text-[13px] font-medium"
        >
          <a href="#hero-sticky" data-i18n="nav.home" class="lp-nav-link whitespace-nowrap">{t.nav.home}</a>
