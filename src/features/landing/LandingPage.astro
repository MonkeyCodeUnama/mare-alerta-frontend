      <div class="relative w-full max-w-4xl max-h-[92dvh] rounded-2xl bg-[oklch(16%_0.014_244)] border border-white/15 p-4 sm:p-5 flex flex-col gap-3.5 text-white shadow-2xl">
        <div class="flex flex-wrap items-center justify-between gap-2">
