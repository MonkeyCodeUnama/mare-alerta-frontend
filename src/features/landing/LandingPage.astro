    <script id="lp-i18n-data" type="application/json" set:html={JSON.stringify(landingCopy)} />

    <script is:inline>
      (function () {
        var navbar = document.getElementById('lp-navbar');
        var jumpVeil = document.getElementById('lp-jump-veil');
        var menuBtn = document.getElementById('lp-menu-btn');
        var menuCloseBtn = document.getElementById('lp-menu-close');
        var mobileMenu = document.getElementById('lp-mobile-menu');
        var mobileNavItems = document.querySelectorAll('.lp-mobile-item');
        var trackedSections = ['#hero-sticky', '#sobre', '#rotina', '#como-funciona']
          .map(function (sel) { return document.querySelector(sel); })
          .filter(Boolean);
        var heroContent = document.getElementById('hero-content');
        var heroBg = document.getElementById('hero-bg-img');
        var heroScrollShade = document.getElementById('hero-scroll-shade');
        var sobreSection = document.getElementById('sobre');
        var sobreBasePanel = document.getElementById('sobre-base-panel');
        var sobreBaseDim = document.getElementById('sobre-base-dim');
        var splitRevealPanel = document.getElementById('split-reveal-panel');
        var sobreRevealRing = document.getElementById('sobre-reveal-ring');
        var splitImgs = splitRevealPanel ? splitRevealPanel.querySelectorAll('.split-reveal-img') : [];
        var darkSurfaceBands = document.querySelectorAll('[data-nav-surface="dark"]');
        var metaTheme = document.getElementById('meta-theme-color');
        var themeBtn = document.getElementById('landing-theme-btn');
        var reducedMotionQuery = window.matchMedia ? window.matchMedia('(prefers-reduced-motion: reduce)') : null;

        var targetReveal = 0;
        var currentReveal = 0;
        var firstPaint = true;
        var rafHandle = 0;
        var lastTs = 0;
        var activeJumpId = 0;

        // Troca fluida de idioma no cliente sem recarregar a página ou perder a posição do scroll
        var i18nStore = null;
        try {
          var i18nEl = document.getElementById('lp-i18n-data');
          if (i18nEl && i18nEl.textContent) {
            i18nStore = JSON.parse(i18nEl.textContent);
          }
        } catch (e) {}

        function resolveKey(obj, path) {
          var parts = path.split('.');
          var cur = obj;
          for (var i = 0; i < parts.length; i++) {
            if (cur == null) return undefined;
            cur = cur[parts[i]];
          }
          return cur;
        }

        function applyLanguage(nextLocale) {
          if (!i18nStore || !i18nStore[nextLocale]) return false;
          var copy = i18nStore[nextLocale];
          var prefersReduced = reducedMotionQuery ? reducedMotionQuery.matches : false;

          var swapTexts = function () {
            document.documentElement.lang = copy.htmlLang;
            document.title = copy.meta.title;

            var metaDesc = document.querySelector('meta[name="description"]');
            if (metaDesc) metaDesc.setAttribute('content', copy.meta.description);

            var metaOgLocale = document.querySelector('meta[property="og:locale"]');
            if (metaOgLocale) metaOgLocale.setAttribute('content', copy.ogLocale);

            document.querySelectorAll('[data-i18n]').forEach(function (el) {
              var val = resolveKey(copy, el.getAttribute('data-i18n'));
              if (typeof val === 'string') el.textContent = val;
            });

            document.querySelectorAll('[data-i18n-alt]').forEach(function (el) {
              var val = resolveKey(copy, el.getAttribute('data-i18n-alt'));
              if (typeof val === 'string') el.setAttribute('alt', val);
            });

            document.querySelectorAll('[data-i18n-aria]').forEach(function (el) {
              var val = resolveKey(copy, el.getAttribute('data-i18n-aria'));
              if (typeof val === 'string') el.setAttribute('aria-label', val);
            });

            document.querySelectorAll('[data-i18n-title]').forEach(function (el) {
              var val = resolveKey(copy, el.getAttribute('data-i18n-title'));
              if (typeof val === 'string') el.setAttribute('title', val);
            });

            document.querySelectorAll('[data-lang-switch]').forEach(function (el) {
              el.setAttribute('data-lang-switch', copy.altLocale);
              el.setAttribute('href', copy.altHref);
            });

            try { localStorage.setItem('mare-alerta-lang', nextLocale); } catch (e) {}

            var targetPath = nextLocale === 'en' ? '/en/' : '/';
            try {
              if (window.history && window.history.replaceState) {
                window.history.replaceState({}, '', targetPath + window.location.hash);
              }
            } catch (e) {}
          };

          if (prefersReduced) {
            swapTexts();
            return true;
          }

          document.documentElement.classList.add('is-switching-lang');
          window.setTimeout(function () {
            swapTexts();
            window.requestAnimationFrame(function () {
              document.documentElement.classList.remove('is-switching-lang');
            });
          }, 90);

          return true;
        }

        document.querySelectorAll('[data-lang-switch]').forEach(function (el) {
          el.addEventListener('click', function (ev) {
            if (ev.metaKey || ev.ctrlKey || ev.shiftKey || ev.altKey || ev.button !== 0) return;
            var nextLang = el.getAttribute('data-lang-switch');
            if (nextLang && applyLanguage(nextLang)) {
              ev.preventDefault();
            }
          });
        });

        function jumpToSection(target) {
          var currentY = window.scrollY || 0;
          var vh = window.innerHeight || 800;
          var targetTop = target.id === 'hero-sticky'
            ? 0
            : Math.max(0, Math.round(target.getBoundingClientRect().top + currentY));

          if (Math.abs(targetTop - currentY) < 24) return;

          var prefersReduced = reducedMotionQuery ? reducedMotionQuery.matches : false;
          var crossesSobre = false;
          if (sobreSection) {
            var sTop = sobreSection.offsetTop;
            var sBottom = sTop + sobreSection.offsetHeight;
            var minY = Math.min(currentY, targetTop);
            var maxY = Math.max(currentY, targetTop);
            crossesSobre = maxY > sTop + vh * 0.16 && minY < sBottom - vh * 0.12;
          }

          if (prefersReduced) {
            window.scrollTo({ top: targetTop, behavior: 'auto' });
            firstPaint = true;
            tickFrame(performance.now());
            return;
          }

          // Salto curto sem cruzar #sobre: rolagem suave nativa
          if (!crossesSobre && Math.abs(targetTop - currentY) <= vh * 1.25) {
            window.scrollTo({ top: targetTop, behavior: 'smooth' });
            return;
          }

          // Salto longo ou cruzando #sobre: dissolve suavemente sem animação reversa ou travamento
          var myJumpId = ++activeJumpId;
          if (jumpVeil) {
            jumpVeil.style.transitionDuration = '140ms';
            jumpVeil.style.opacity = '1';
          }

          window.setTimeout(function () {
            if (myJumpId !== activeJumpId) return;
            window.scrollTo({ top: targetTop, behavior: 'auto' });

            document.querySelectorAll('.reveal-item:not(.is-visible)').forEach(function (item) {
              var rect = item.getBoundingClientRect();
              if (rect.top < vh * 1.05 && rect.bottom > 0) {
                item.classList.add('is-visible');
              }
            });

            firstPaint = true;
            tickFrame(performance.now());

            window.requestAnimationFrame(function () {
              if (myJumpId !== activeJumpId) return;
              if (jumpVeil) {
                jumpVeil.style.transitionDuration = '240ms';
                jumpVeil.style.opacity = '0';
              }
            });
          }, 145);
        }

        function updateActiveNavLink() {
          if (!mobileNavItems.length || !trackedSections.length) return;
          var vh = window.innerHeight || 800;
          var probeOffset = Math.max(96, Math.round(vh * 0.35));
          var activeId = trackedSections[0].id;
          for (var i = 0; i < trackedSections.length; i++) {
            var sec = trackedSections[i];
            if (sec.getBoundingClientRect().top <= probeOffset) {
              activeId = sec.id;
            }
          }
          mobileNavItems.forEach(function (item) {
            item.classList.toggle('is-active', item.getAttribute('href') === '#' + activeId);
          });
        }

        function setMobileMenu(open) {
          if (!mobileMenu || !menuBtn) return;
          mobileMenu.classList.toggle('is-open', open);
          mobileMenu.classList.toggle('is-closed', !open);
          menuBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
          document.documentElement.style.overflow = open ? 'hidden' : '';
          if (open) updateActiveNavLink();
        }

        document.querySelectorAll('a[href="#hero-sticky"], a[href="#sobre"], a[href="#rotina"], a[href="#como-funciona"]').forEach(function (anchor) {
          anchor.addEventListener('click', function (ev) {
            var href = anchor.getAttribute('href');
            var target = href ? document.querySelector(href) : null;
            if (!target) return;
            ev.preventDefault();
            setMobileMenu(false);
            jumpToSection(target);
          });
        });

        if (menuBtn && mobileMenu) {
          menuBtn.addEventListener('click', function (ev) {
            ev.stopPropagation();
            var isOpen = mobileMenu.classList.contains('is-open');
            setMobileMenu(!isOpen);
          });
          if (menuCloseBtn) {
            menuCloseBtn.addEventListener('click', function () {
              setMobileMenu(false);
            });
          }
          mobileMenu.querySelectorAll('a').forEach(function (link) {
            link.addEventListener('click', function () {
              setMobileMenu(false);
            });
          });
          document.addEventListener('click', function (ev) {
            if (!mobileMenu.classList.contains('is-open')) return;
            if (!mobileMenu.contains(ev.target) && !menuBtn.contains(ev.target)) {
              setMobileMenu(false);
            }
          });
          document.addEventListener('keydown', function (ev) {
            if (ev.key === 'Escape') setMobileMenu(false);
          });
        }

        function computeTargetReveal(vh) {
          if (!sobreSection) return 0;
          var sobreRect = sobreSection.getBoundingClientRect();
          var sScrollable = Math.max(sobreSection.offsetHeight - vh, 1);
          var rawProgress = -sobreRect.top / sScrollable;
          return Math.min(Math.max((rawProgress - 0.16) / 0.66, 0), 1);
        }

        function updateNavbarContrast(theme) {
          if (!navbar) return;
          if (theme === 'dark') {
            navbar.classList.remove('lp-navbar-on-light');
            return;
          }

          var probeY = 36;
          var overDark = false;
          for (var i = 0; i < darkSurfaceBands.length; i++) {
            var band = darkSurfaceBands[i];
            var rect = band.getBoundingClientRect();
            var topInset = band.id === 'hero-sticky' ? 0 : (band.id === 'como-funciona-header' ? 76 : 56);
            var bottomInset = band.id === 'hero-sticky'
              ? 18
              : (band.classList.contains('final-cta-stage') ? 0 : (band.id === 'como-funciona-header' ? 76 : 56));
            if (rect.top + topInset <= probeY && rect.bottom - bottomInset > probeY) {
              overDark = true;
              break;
            }
          }

          navbar.classList.toggle('lp-navbar-on-light', !overDark);
        }

        function renderSobreFrame(prefersReduced, vw, vh) {
          if (!sobreSection || !splitRevealPanel) return;

          if (prefersReduced) {
            var snapped = targetReveal >= 0.5 ? 1 : 0;
            splitRevealPanel.style.visibility = snapped ? 'visible' : 'hidden';
            splitRevealPanel.style.clipPath = snapped ? 'none' : 'circle(0px at 50% 50%)';
            if (sobreBasePanel) {
              sobreBasePanel.style.transform = 'none';
              sobreBasePanel.style.visibility = snapped ? 'hidden' : 'visible';
            }
            if (sobreBaseDim) sobreBaseDim.style.opacity = '0';
            if (sobreRevealRing) sobreRevealRing.style.opacity = '0';
            splitImgs.forEach(function (img) {
              img.style.transform = 'none';
            });
            return;
          }

          var eased =
            currentReveal < 0.5
              ? 2 * currentReveal * currentReveal
              : 1 - Math.pow(-2 * currentReveal + 2, 2) / 2;

          if (eased <= 0.001) {
            splitRevealPanel.style.visibility = 'hidden';
            splitRevealPanel.style.clipPath = 'circle(0px at 50% 50%)';
          } else {
            splitRevealPanel.style.visibility = 'visible';
            var maxRadiusPx = Math.hypot(vw * 0.5, vh * 0.5) + 6;
            var rPx = eased * maxRadiusPx;
            if (eased >= 0.996) {
              splitRevealPanel.style.clipPath = 'none';
            } else {
              splitRevealPanel.style.clipPath = 'circle(' + rPx.toFixed(1) + 'px at 50% 50%)';
            }

            if (sobreRevealRing) {
              var scaleRatio = (rPx * 2) / 200;
              var ringOpacity = 0;
              if (eased > 0.01 && eased < 0.96) {
                var fadeIn = Math.min(eased / 0.10, 1);
                var fadeOut = Math.min((0.96 - eased) / 0.16, 1);
                ringOpacity = 0.85 * fadeIn * fadeOut;
              }
              sobreRevealRing.style.transform = 'translate(-50%, -50%) scale(' + scaleRatio.toFixed(4) + ')';
              sobreRevealRing.style.opacity = ringOpacity.toFixed(3);
            }
          }

          if (eased <= 0.001 && sobreRevealRing) {
            sobreRevealRing.style.opacity = '0';
          }

          var imgScale = 1.06 - eased * 0.06;
          splitImgs.forEach(function (img) {
            img.style.transform = 'scale(' + imgScale.toFixed(4) + ')';
          });

          if (sobreBasePanel) {
            var baseScale = 1 - eased * 0.035;
            sobreBasePanel.style.transform = 'scale(' + baseScale.toFixed(4) + ')';
            sobreBasePanel.style.visibility = eased >= 0.995 ? 'hidden' : 'visible';
          }
          if (sobreBaseDim) {
            sobreBaseDim.style.opacity = (eased * 0.55).toFixed(3);
          }
        }

        function tickFrame(now) {
          /* Fase 1: leituras geométricas em lote para evitar layout thrashing */
          var currentY = window.scrollY || 0;
          var vw = document.documentElement.clientWidth || window.innerWidth || 1280;
          var vh = window.innerHeight || 800;
          var prefersReduced = reducedMotionQuery ? reducedMotionQuery.matches : false;
          var dt = lastTs ? Math.min(Math.max((now - lastTs) / 16.667, 0.2), 3) : 1;
          lastTs = now;
          var themeNow = document.documentElement.getAttribute('data-theme') || 'light';

          targetReveal = computeTargetReveal(vh);

          if (prefersReduced || firstPaint) {
            currentReveal = targetReveal;
            firstPaint = false;
          } else {
            var diff = targetReveal - currentReveal;
            if (Math.abs(diff) <= 0.0006) {
              currentReveal = targetReveal;
            } else {
              var alpha = 1 - Math.pow(1 - 0.075, dt);
              var delta = diff * alpha;
              var maxStep = 0.015 * dt;
              if (Math.abs(delta) > maxStep) {
                delta = (delta > 0 ? 1 : -1) * maxStep;
              }
              currentReveal += delta;
            }
          }

          updateNavbarContrast(themeNow);
          if (vw >= 1024 && mobileMenu && mobileMenu.classList.contains('is-open')) {
            setMobileMenu(false);
          } else {
            updateActiveNavLink();
          }

          /* Fase 2: escritas visuais em lote na GPU */
          var heroProgress = Math.min(Math.max(currentY / (vh * 0.85), 0), 1);
          if (heroContent) {
            heroContent.style.opacity = prefersReduced ? '1' : String(1 - heroProgress * 0.85);
            heroContent.style.transform = prefersReduced ? 'none' : 'translateY(' + (-heroProgress * 24).toFixed(1) + 'px)';
          }
          if (heroBg) {
            heroBg.style.transform = prefersReduced ? 'none' : 'scale(' + (1 + heroProgress * 0.05).toFixed(4) + ')';
          }
          if (heroScrollShade) {
            heroScrollShade.style.opacity = prefersReduced ? '0' : (heroProgress * 0.38).toFixed(3);
          }

          renderSobreFrame(prefersReduced, vw, vh);

          if (!prefersReduced && Math.abs(targetReveal - currentReveal) > 0.0006) {
            rafHandle = window.requestAnimationFrame(tickFrame);
          } else {
            rafHandle = 0;
            lastTs = 0;
          }
        }

        function requestEffects() {
          if (!rafHandle) {
            rafHandle = window.requestAnimationFrame(tickFrame);
          }
        }

        function syncThemeControls(theme) {
          var isDark = theme === 'dark';
          if (themeBtn) themeBtn.setAttribute('aria-pressed', isDark ? 'true' : 'false');
          if (metaTheme) metaTheme.setAttribute('content', isDark ? '#0d131f' : '#f4f6f9');
        }

        function applyLandingTheme(next, useTransition) {
          var commit = function () {
            document.documentElement.setAttribute('data-theme', next);
            try { localStorage.setItem('mare-alerta-theme', next); } catch (e) {}
            syncThemeControls(next);
            updateNavbarContrast(next);
          };

          var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          if (useTransition && !reduceMotion && typeof document.startViewTransition === 'function') {
            document.documentElement.classList.add('is-theme-switching');
            var vt = document.startViewTransition(function () {
              commit();
            });
            vt.finished.finally(function () {
              document.documentElement.classList.remove('is-theme-switching');
            });
            return;
          }

          commit();
        }

        syncThemeControls(document.documentElement.getAttribute('data-theme') || 'light');

        if (themeBtn) {
          themeBtn.addEventListener('click', function () {
            var cur = document.documentElement.getAttribute('data-theme') || 'light';
            var next = cur === 'dark' ? 'light' : 'dark';
            applyLandingTheme(next, true);
          });
        }

        // Interação nos previews reais (Lightbox com troca Claro/Escuro + tilt suave nos smartphones)
        var previewModal = document.getElementById('lp-preview-modal');
        var previewModalTitle = document.getElementById('lp-preview-modal-title');
        var previewModalImg = document.getElementById('lp-preview-modal-img');
        var previewThemeBtn = document.getElementById('lp-preview-theme-toggle');
        var previewCloseBtn = document.getElementById('lp-preview-close');
        var currentPreviewBase = '';
        var currentPreviewMode = 'light';

        function syncModalImage() {
          if (!previewModalImg || !currentPreviewBase) return;
          previewModalImg.setAttribute('src', '/previews/' + currentPreviewBase + '-' + currentPreviewMode + '.webp');
        }

        function openPreviewModal(base, title) {
          if (!previewModal || !previewModalTitle || !previewModalImg) return;
          currentPreviewBase = base;
          currentPreviewMode = (document.documentElement.getAttribute('data-theme') === 'dark') ? 'dark' : 'light';
          previewModalTitle.textContent = title || 'Visualização do sistema';
          previewModalImg.setAttribute('alt', title || 'Tela do sistema Maré Alerta');
          syncModalImage();
          previewModal.classList.remove('hidden');
          document.body.style.overflow = 'hidden';
        }

        function closePreviewModal() {
          if (!previewModal) return;
          previewModal.classList.add('hidden');
          document.body.style.overflow = '';
        }

        document.querySelectorAll('[data-preview-trigger]').forEach(function (btn) {
          btn.addEventListener('click', function () {
            var base = btn.getAttribute('data-preview-trigger') || '';
            var title = btn.getAttribute('data-preview-title') || '';
            if (base) openPreviewModal(base, title);
          });
        });

        if (previewThemeBtn) {
          previewThemeBtn.addEventListener('click', function () {
            currentPreviewMode = currentPreviewMode === 'dark' ? 'light' : 'dark';
            syncModalImage();
          });
        }
        if (previewCloseBtn) previewCloseBtn.addEventListener('click', closePreviewModal);
        if (previewModal) {
          previewModal.addEventListener('click', function (ev) {
            if (ev.target === previewModal) closePreviewModal();
          });
        }
        document.addEventListener('keydown', function (ev) {
          if (ev.key === 'Escape' && previewModal && !previewModal.classList.contains('hidden')) {
            closePreviewModal();
          }
        });

        if (window.matchMedia && window.matchMedia('(pointer: fine)').matches) {
          document.querySelectorAll('.lp-tilt-stage').forEach(function (stage) {
            var phone = stage.querySelector('.lp-tilt-phone');
            if (!phone) return;
            stage.addEventListener('pointermove', function (ev) {
              var rect = stage.getBoundingClientRect();
              var rx = ((ev.clientY - rect.top) / rect.height - 0.5) * -6;
              var ry = ((ev.clientX - rect.left) / rect.width - 0.5) * 6;
              phone.style.transform = 'perspective(900px) rotateX(' + rx.toFixed(2) + 'deg) rotateY(' + ry.toFixed(2) + 'deg)';
            });
            stage.addEventListener('pointerleave', function () {
              phone.style.transform = '';
            });
          });
        }

        window.addEventListener('scroll', requestEffects, { passive: true });
        window.addEventListener('resize', requestEffects, { passive: true });
        tickFrame(performance.now());

        // Revelar elementos suavemente quando entram no campo de visão
        var revealNodes = document.querySelectorAll('.reveal-item');
        if ('IntersectionObserver' in window && revealNodes.length) {
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          }, { threshold: 0.12 });
          revealNodes.forEach(function (el) { io.observe(el); });
        } else {
          revealNodes.forEach(function (el) { el.classList.add('is-visible'); });
        }

        // Reflexo líquido direcionado pelo ponteiro nos botões
        document.querySelectorAll('.btn-water-pill').forEach(function (pill) {
          pill.addEventListener('pointermove', function (ev) {
            var rect = pill.getBoundingClientRect();
            pill.style.setProperty('--mx', (ev.clientX - rect.left) + 'px');
            pill.style.setProperty('--my', (ev.clientY - rect.top) + 'px');
          });
        });

        // Em localhost, desregistra SW e limpa caches; em produção, registra /sw.js
        if ('serviceWorker' in navigator) {
          var isLocal =
            window.location.hostname === 'localhost' ||
            window.location.hostname === '127.0.0.1';
          if (isLocal) {
            navigator.serviceWorker
              .getRegistrations()
              .then(function (regs) {
                regs.forEach(function (reg) {
                  reg.unregister();
                });
              })
              .catch(function () {});
            if ('caches' in window) {
              caches
                .keys()
                .then(function (keys) {
                  keys.forEach(function (k) {
                    caches.delete(k);
                  });
                })
                .catch(function () {});
            }
          } else {
            window.addEventListener('load', function () {
              navigator.serviceWorker.register('/sw.js').catch(function () {});
            });
          }
        }
      })();
    </script>
  </body>
</html>
